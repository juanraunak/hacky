# Copy to client/.env.local to override. These are the production defaults and
# are baked into the bundle at build time, so a change needs a rebuild.
#
# The scheme matters: the SpacetimeDB SDK maps https -> wss and http -> ws, and
# passes an explicit ws:/wss: through unchanged. Production must be https (or
# wss); a production build upgrades http/ws automatically and logs an error.
VITE_SPACETIME_URI=https://maincloud.spacetimedb.com
VITE_SPACETIME_DB=hacky-world1

# NOTE: the database is `hacky-world1`, not `hacky`. `hacky` was published by a
# CLI identity nobody still holds, so it can no longer be updated and does not
# have the World 2 tables. `hacky-world1` is owned by the account logged in on
# this machine and carries the whole schema. If you regain access to `hacky`,
# publish the module there and change this back in both env files.

# --- welcome mail --------------------------------------------------------
# Two ways to send. EmailJS wins when all three of its values are set.
#
# 1. EmailJS -- the way to send AS a Gmail address with no server. The mailbox
#    is connected by OAuth and the browser holds only the PUBLIC key, which is
#    designed to be public and ships in the bundle either way. From the EmailJS
#    dashboard:
#      Email Services  -> the connected Gmail -> Service ID
#      Email Templates -> your template       -> Template ID
#      Account -> General                     -> Public Key
#    The template must set "To email" to {{to_email}} and use {{subject}} and
#    {{message}} in the subject and body, or every welcome mail goes to the
#    account owner instead of to the player who signed up.
#    Add the site's origins under Account -> Security -> Allowed origins, or
#    anyone can lift these from the bundle and spend the quota.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# 2. /api/welcome -- used when the EmailJS values above are empty. Holds a
#    Resend key server-side (RESEND_API_KEY in client/.env.local for dev, and
#    in the Static Web App's Application Settings for the deployed site) and
#    writes its own text. RESEND_FROM needs a domain verified with Resend;
#    without one it falls back to onboarding@resend.dev, which only delivers
#    to the address that owns the Resend account.
#    Only set this to point somewhere other than /api/welcome.
VITE_WELCOME_EMAIL_URL=
