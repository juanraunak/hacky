# Copy to client/.env.local to override. These are the production defaults and
# are baked into the bundle at build time, so a change needs a rebuild.
#
# The scheme matters: the SpacetimeDB SDK maps https -> wss and http -> ws, and
# passes an explicit ws:/wss: through unchanged. Production must be https (or
# wss); a production build upgrades http/ws automatically and logs an error.
VITE_SPACETIME_URI=https://maincloud.spacetimedb.com
VITE_SPACETIME_DB=hacky-world1

# NOTE: the database is `hacky-world1`, not `hacky`. `hacky` was published by a
# CLI identity nobody still holds, so it can no longer be updated and does not
# have the World 2 tables. `hacky-world1` is owned by the account logged in on
# this machine and carries the whole schema. If you regain access to `hacky`,
# publish the module there and change this back in both env files.

# --- welcome mail --------------------------------------------------------
# The SpacetimeDB module has no outbound network, so the welcome mail is sent
# from the browser. That rules out any secret key: whatever is here ships to
# every visitor.
#
# EmailJS is the way to send AS a Gmail address (juanraunakbc@gmail.com). You
# connect the mailbox by OAuth on emailjs.com and the browser only holds the
# public key, which is designed to be public. Three values, from the EmailJS
# dashboard:
#   Email Services -> the connected Gmail  -> Service ID
#   Email Templates -> your template       -> Template ID
#   Account -> General                     -> Public Key
# The template needs {{to_email}}, {{subject}} and {{message}}, and "To email"
# set to {{to_email}}, or it will send to you instead of to the new player.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Fallback for any other JSON receiver that holds its own key server-side: a
# Zapier or Make webhook, an Azure Function. Used only when the EmailJS values
# above are empty. Body: { "email": "...", "subject": "...", "message": "..." }
VITE_WELCOME_EMAIL_URL=
